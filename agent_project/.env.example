# Copy to .env (which is git-ignored) and fill in your own values.
# Never commit real API keys.

OPENAI_API_KEY=sk-...
AGENT_MODEL=openai:gpt-5.4-mini
# none|low|medium|high|xhigh|max — for Luna + tools on chat.completions use none
AGENT_REASONING_EFFORT=medium

# Working robots SmallDeliveryRobot_0..N-1 (leaders/planners are extra where used). Allowed: 2, 4, 6, 8.
AGENT_COUNT=4

# Centralized / HMAS broker
AGENT_BROKER_HOST=127.0.0.1
AGENT_BROKER_PORT=8765

# Conflict-based mesh (solo peers + event negotiation)
AGENT_MESH_HOST=127.0.0.1
AGENT_MESH_BASE_PORT=9101
AGENT_PLANNER_MESH_PORT=9100

# Optional Nav2 namespace overrides (defaults: id itself = SmallDeliveryRobot_0 ..)
# AGENT_NAV_SmallDeliveryRobot_0=SmallDeliveryRobot_0
# Legacy: AGENT_NAV_TB1=...

# Usage monitor (token usage + message-count dashboard)
AGENT_MONITOR_HOST=127.0.0.1
AGENT_MONITOR_PORT=9900
# Agent Trace window (LLM text + tool usage scrollback)
AGENT_TRACE_MONITOR_PORT=9901

# Current map/world id — MCP list_stations / get_map_info share this (items/<id>.json)
# Only a real .env is read; editing THIS template changes nothing.
# AGENT_WORLD=bottleneck_1 ./launch_hmas1.sh --agents 2
AGENT_WORLD=bottleneck_1
# AGENT_WORLDS_DIR=/path/to/Masterarbeit/worlds
# Switch at runtime with MCP set_world / get_map_info(world_id=...)

# HMAS-1: actions per robot in one central plan (later steps assumed to succeed)
# HMAS1_CHUNK_STEPS=4

# MCP tool server
AGENT_MCP_URL=http://127.0.0.1:8000/sse
# Max distance (m) from station center for pickup_box / drop_box (default 1.8)
# MCP_MANIP_RADIUS_M=1.8
