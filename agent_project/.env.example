# Copy to .env (which is git-ignored) and fill in your own values.
# Never commit real API keys.

OPENAI_API_KEY=sk-...
AGENT_MODEL=openai:gpt-5.4-mini
# none|minimal|low|medium|high|xhigh|max
# gpt-5 / gpt-5-mini: use minimal (none is rejected). Luna + tools on chat.completions: none
AGENT_REASONING_EFFORT=minimal

# One Q1 with three specialists: navigator, lidar, camera
AGENT_PLATFORM=q1
AGENT_COUNT=3
AGENT_NAV_ROBOT=q1
AGENT_WORLD=open
# Semantic lidar is 360° (Velodyne). Set below 360 only for a tighter cone.
AGENT_SEM_LIDAR_FOV_DEG=360
# Camera stills for the multimodal camera agent (written by q1_sensor_summarizer)
AGENT_CAMERA_RGB_JPEG=/tmp/q1_camera_rgb.jpg
AGENT_CAMERA_SEM_JPEG=/tmp/q1_camera_semantic.jpg
AGENT_CMD_VEL_TOPIC=/cmd_vel

# Centralized / HMAS broker
AGENT_BROKER_HOST=127.0.0.1
AGENT_BROKER_PORT=8765

# Conflict-based mesh (solo peers + event negotiation)
AGENT_MESH_HOST=127.0.0.1
AGENT_MESH_BASE_PORT=9101
AGENT_PLANNER_MESH_PORT=9100

# Usage monitor (token usage + message-count dashboard)
AGENT_MONITOR_HOST=127.0.0.1
AGENT_MONITOR_PORT=9900
# Agent Trace window (LLM text + tool usage scrollback)
AGENT_TRACE_MONITOR_PORT=9901

# MCP tool server
AGENT_MCP_URL=http://127.0.0.1:8000/sse

# Mission wall-clock limit from prompt (bare number = minutes). Example:
#   ./launch_dmas.sh --timeout 10     # easy semantic tour (10 min)
#   ./launch_dmas.sh --timeout 15m    # medium
# Or set seconds directly:
# EXPERIMENT_TIMEOUT_SEC=600
# EXPERIMENT_TIMEOUT=10
# Per-leg mesh wait (seconds, default 300):
# DMAS_EXECUTE_TIMEOUT=300
