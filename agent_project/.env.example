# Copy to .env (which is git-ignored) and fill in your own values.
# Never commit real API keys.

OPENAI_API_KEY=sk-...
AGENT_MODEL=openai:gpt-5

# Centralized / HMAS-1 broker
AGENT_BROKER_HOST=127.0.0.1
AGENT_BROKER_PORT=8765

# Conflict-based mesh (solo peers + event negotiation)
AGENT_MESH_HOST=127.0.0.1
AGENT_MESH_BASE_PORT=9101
AGENT_PLANNER_MESH_PORT=9100

# Usage monitor (token usage + message-count dashboard)
AGENT_MONITOR_HOST=127.0.0.1
AGENT_MONITOR_PORT=9900

# MCP tool server
AGENT_MCP_URL=http://127.0.0.1:8000/sse
