<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-label-system"
      name="gz::sim::systems::Label">
    </plugin>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <model name="turtlebot3_arena_walls">
      <static>1</static>
      <include>
        <uri>model://turtlebot3_arena_walls</uri>
      </include>
    </model>

    <!-- GOOSE-labeled props for Experiment 06 (semantic tour).
         Q1 spawn is (0, 0). Objects sit in four corners so "nearest X" is unambiguous. -->
    <include>
      <uri>file:///opt/atb_hsu/share/iosb_gazebo_ressources/worlds/assets/props/rocks/iosb_rock1/</uri>
      <name>rock_easy</name>
      <pose>10.5 -10.5 0 0 0 0</pose>
    </include>

    <include>
      <uri>file:///opt/atb_hsu/share/iosb_gazebo_ressources/worlds/assets/props/barrels/yellow_barrell/</uri>
      <name>barrel_easy</name>
      <pose>-10.5 10.5 0 0 0 0</pose>
    </include>

    <!-- Car mesh is too large for this arena; labeled box with GOOSE class 12. -->
    <model name="car_proxy">
      <static>true</static>
      <pose>10.5 10.5 0.275 0 0 0</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>12</label>
      </plugin>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.6 0.8 0.55</size></box></geometry>
        </collision>
        <visual name="v">
          <laser_retro>12</laser_retro>
          <geometry><box><size>1.6 0.8 0.55</size></box></geometry>
          <material>
            <ambient>0.15 0.2 0.55 1</ambient>
            <diffuse>0.2 0.25 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="container_proxy">
      <static>true</static>
      <pose>-10.5 -10.5 0.5 0 0 0</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>58</label>
      </plugin>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.2 0.9 1.0</size></box></geometry>
        </collision>
        <visual name="v">
          <laser_retro>58</laser_retro>
          <geometry><box><size>1.2 0.9 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.15 1</ambient>
            <diffuse>0.7 0.5 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
