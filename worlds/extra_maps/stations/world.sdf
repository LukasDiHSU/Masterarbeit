<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <model name="turtlebot3_arena_walls">
      <static>1</static>
      <include>
        <uri>model://turtlebot3_arena_walls</uri>
      </include>
    </model>

    <model name="center_block">
      <static>true</static>
      <pose>0.000 0.000 0.350 0 0 0.0000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.600 1.600 0.700</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1.600 1.600 0.700</size></box></geometry>
          <material>
            <ambient>0.350 0.350 0.400 1</ambient>
            <diffuse>0.350 0.350 0.400 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="chicane_nw">
      <static>true</static>
      <pose>-1.100 1.100 0.250 0 0 0.0000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.450 0.450 0.500</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.450 0.450 0.500</size></box></geometry>
          <material>
            <ambient>0.500 0.350 0.200 1</ambient>
            <diffuse>0.500 0.350 0.200 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="chicane_ne">
      <static>true</static>
      <pose>1.100 1.100 0.250 0 0 0.0000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.450 0.450 0.500</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.450 0.450 0.500</size></box></geometry>
          <material>
            <ambient>0.500 0.350 0.200 1</ambient>
            <diffuse>0.500 0.350 0.200 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="chicane_se">
      <static>true</static>
      <pose>1.100 -1.100 0.250 0 0 0.0000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.450 0.450 0.500</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.450 0.450 0.500</size></box></geometry>
          <material>
            <ambient>0.500 0.350 0.200 1</ambient>
            <diffuse>0.500 0.350 0.200 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="chicane_sw">
      <static>true</static>
      <pose>-1.100 -1.100 0.250 0 0 0.0000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.450 0.450 0.500</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.450 0.450 0.500</size></box></geometry>
          <material>
            <ambient>0.500 0.350 0.200 1</ambient>
            <diffuse>0.500 0.350 0.200 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="station_a">
      <static>true</static>
      <pose>-1.900 -1.900 0.030 0 0 0.0000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.550 0.550 0.060</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.550 0.550 0.060</size></box></geometry>
          <material>
            <ambient>0.100 0.750 0.200 1</ambient>
            <diffuse>0.100 0.750 0.200 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="station_b">
      <static>true</static>
      <pose>-1.900 1.900 0.030 0 0 0.0000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.550 0.550 0.060</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.550 0.550 0.060</size></box></geometry>
          <material>
            <ambient>0.150 0.450 0.900 1</ambient>
            <diffuse>0.150 0.450 0.900 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="station_c">
      <static>true</static>
      <pose>1.900 1.900 0.030 0 0 0.0000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.550 0.550 0.060</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.550 0.550 0.060</size></box></geometry>
          <material>
            <ambient>0.950 0.800 0.100 1</ambient>
            <diffuse>0.950 0.800 0.100 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="station_d">
      <static>true</static>
      <pose>1.900 -1.900 0.030 0 0 0.0000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.550 0.550 0.060</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.550 0.550 0.060</size></box></geometry>
          <material>
            <ambient>0.850 0.200 0.550 1</ambient>
            <diffuse>0.850 0.200 0.550 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
